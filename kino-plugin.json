{
  "id": "serieskao",
  "name": "SeriesKao",
  "version": "0.3.10",
  "apiVersion": 30,
  "entry": "plugin.js",
  "icon": "icon.png",
  "description": "Series, anime, doramas y películas en español de serieskao.top: sección propia, géneros, búsqueda, episodios y varios servidores por título.",
  "author": "xuper-plugin",
  "homepage": "https://github.com/xuper-plugin/kino-plugin-serieskao",
  "discoverable": true,
  "hosts": [
    "serieskao.top",
    "embed69.org",
    "voe.sx",
    "vidhide.com",
    "vidhidepro.com",
    "vidhideplus.com",
    "vidhidefast.com",
    "callistanise.com",
    "dintezuvio.com",
    "minochinos.com",
    "filelions.to",
    "morencius.com",
    "embedwish.com",
    "hglink.to",
    "hlswish.com",
    "streamwish.com",
    "streamwish.to",
    "strwish.com",
    "wishembed.com",
    "filelions.com",
    "vibuxer.com",
    "*.premilkyway.com"
  ],
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve",
    "download",
    "scopedSearch",
    "screen"
  ],
  "browser": true,
  "streamHosts": "any",
  "categories": [
    "movies",
    "series"
  ],
  "color": "#E11D48",
  "section": {
    "label": "SeriesKao",
    "labelEn": "SeriesKao"
  },
  "theme": {
    "accent": "#F43F5E",
    "onAccent": "#1A0309",
    "background": "#0E0709",
    "surface": "#1C0F13",
    "highlight": "#FDA4AF"
  },
  "settings": [
    {
      "key": "siteSection",
      "type": "section",
      "label": "Sitio",
      "labelEn": "Site",
      "hint": "Si serieskao.top cambia de dominio, escribe aquí la dirección nueva (https) y el plugin sigue funcionando, sin esperar una actualización.",
      "hintEn": "If serieskao.top moves to a new domain, type the new address (https) here and the plugin keeps working, with no update to wait for."
    },
    {
      "key": "site",
      "type": "text",
      "label": "Dirección del sitio",
      "labelEn": "Site address",
      "default": "https://serieskao.top",
      "hint": "https://serieskao.top",
      "hintEn": "https://serieskao.top"
    },
    {
      "key": "audioSection",
      "type": "section",
      "label": "Idioma",
      "labelEn": "Language",
      "hint": "Cada título puede traer varios idiomas; Kino abre primero el que elijas y, si falla, los demás.",
      "hintEn": "A title may come in several languages; Kino opens the one you pick first and, if it fails, the others."
    },
    {
      "key": "audio",
      "type": "select",
      "label": "Idioma preferido",
      "labelEn": "Preferred language",
      "default": "lat",
      "options": [
        {
          "value": "lat",
          "label": "Latino",
          "labelEn": "Latino"
        },
        {
          "value": "cast",
          "label": "Castellano",
          "labelEn": "Castilian"
        },
        {
          "value": "sub",
          "label": "Subtitulado",
          "labelEn": "Subtitled"
        }
      ]
    },
    {
      "key": "info",
      "type": "status",
      "label": "Estado",
      "labelEn": "Status"
    },
    {
      "key": "clearCache",
      "type": "action",
      "label": "Vaciar caché",
      "labelEn": "Clear cache",
      "confirm": "¿Vaciar la caché de listas?",
      "confirmEn": "Clear the list cache?"
    }
  ],
  "telemetry": true,
  "fetchHosts": "any",
  "recommends": [
    "xuper-plugin/kino-plugin-kino-resolver"
  ],
  "consumes": {
    "resolver": {
      "repo": "xuper-plugin/kino-plugin-kino-resolver",
      "door": "resolver",
      "calls": [
        "resolve"
      ]
    }
  },
  "screen": {
    "label": "SeriesKao",
    "labelEn": "SeriesKao",
    "icon": "movie",
    "menuOpens": "screen",
    "opensFrom": [
      "menu",
      "settings"
    ],
    "settingsButton": {
      "label": "Abrir SeriesKao",
      "labelEn": "Open SeriesKao"
    },
    "settingsIn": "both"
  },
  "provides": {
    "catalog": {
      "summary": "Titles this plugin finds, for the author's other plugins",
      "calls": {
        "search": {
          "in": {
            "q": "string",
            "type": "string?"
          },
          "out": "Item[]"
        }
      },
      "types": {
        "Item": {
          "id": "string",
          "ref": "string",
          "title": "string",
          "kind": "string",
          "poster": "string?",
          "backdrop": "string?",
          "year": "string?",
          "overview": "string?",
          "tmdb": "number?"
        }
      }
    }
  },
  "signature": {
    "authorKey": "6693946bd5c56196960959c4b9665fad5094374bcb85ddb282f8bf762c835263",
    "value": "ff302e6678d41956a1617ca1d1e99373169f5a4b1ff6faa09b5e88daacdf591b3ac1acfd7930be724d8fc40d0cd090e323dec24af9d97a8b22149872ba97fe0b"
  }
}
